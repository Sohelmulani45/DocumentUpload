@model DocumentUploadApp.MVC.Models.EmployeeVM

@{
    ViewData["Title"] = "Employee Form";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <!-- Card Container -->
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <h2 class="mb-0 fw-bold">
                        <i class="bi bi-person-plus-fill me-2"></i>Employee Details form
                    </h2>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Index" method="post" enctype="multipart/form-data">

                        <!-- Name Field -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="bi bi-person me-2"></i>Full Name
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Enter your full name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>


                        <!-- File Upload Field -->
                        <div class="mb-4">
                            <label asp-for="File" class="form-label fw-semibold">
                                <i class="bi bi-paperclip me-2"></i>Upload Document
                            </label>
                            <input asp-for="File" type="file" class="form-control form-control-lg" />
                            <div class="form-text">Supported formats: PDF, DOC, DOCX, JPG, PNG (Max 5MB)</div>
                            <span asp-validation-for="File" class="text-danger"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold py-3">
                                <i class="bi bi-check-circle me-2"></i>Submit
                            </button>
                        </div>

                    </form>

                    <!-- Success Message -->
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mt-4 rounded-3" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <strong>Success!</strong> @ViewBag.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light text-center py-3 rounded-bottom-4">
                    <small class="text-muted">
                        <i class="bi bi-shield-check me-1"></i>All information is secure and confidential
                    </small>
                </div>
            </div>

        </div>
    </div>
</div>

